-- Display customers with their orders.

select orders.product,
customer.name
from customer
inner join orders on customer.id=orders.cid;

-- Display customers who have never placed an order.

select customer.name,
orders.product
from customer
left join orders on customer.id = orders.cid;

-- Display the customer who spent the most.

select customer.name,
orders.amount
from customer
inner join orders on customer.id = orders.cid
where orders.amount=(
  select max(amount)
  from orders
);

-- Display all customers who ordered a Shoes.

select customer.name,
orders.product
from customer
inner join orders on customer.id = orders.cid
where orders.product='Shoes';

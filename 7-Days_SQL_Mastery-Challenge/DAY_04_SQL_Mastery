select * from student;

-- Display students with marks between 70 and 80.

select name,marks
from student
where marks between 70 and 80;

-- Display students from Bangalore or Mysore.

select name
from student
where address in ('Bangalore','Mysore');

-- Display students whose names contain 'an'.

select name
from student
where name like '%an%';

-- Display students whose names start with 'A'.

select name
from student
where name like 'A%';

-- Display students whose names end with 'a'.

select name
from student
where name like '%a';


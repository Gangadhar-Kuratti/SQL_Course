select * from student;

-- Display students who scored more than 80 marks.

select name
from student
where marks>80;

-- Display students from Bangalore ordered by marks (highest first).

select name, marks
from student
where city='Bangalore'
order by  marks desc;

-- Update the marks of the student named "Rahul" to 95.

update student
set marks=95
where name='rahul';

-- Count the number of BCA students.

select count(roll_no)
from student
where course='BCA';

-- Delete students whose marks are below 35.

delete from student
where marks<35;
